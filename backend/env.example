# Server Configuration
PORT=8080

# Google AI API (for Gemini 2.0 Flash audio processing and LLM)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Google Cloud (for Text-to-Speech)
# Set up service account authentication with one of these methods:
# 1. Set GOOGLE_APPLICATION_CREDENTIALS to path of service account JSON file
# 2. Or run: gcloud auth application-default login
# 3. Or use default service account on GCP (if running on GCP)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your_project_id

# Development
NODE_ENV=development