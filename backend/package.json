{
  "name": "bt-speaker-backend",
  "version": "1.0.0",
  "description": "WebSocket voice streaming backend for ESP32 BT Speaker",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run copy:wakeword-worker",
    "copy:wakeword-worker": "cp src/voice/wakeword-worker.py dist/voice/wakeword-worker.py",
    "start": "node dist/server.js",
    "start:live": "npm run build && node dist/live-server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:live": "ts-node-dev --respawn --transpile-only src/live-server.ts",
    "watch": "tsc --watch",
    "setup:wakeword": "cd models/wakeword && ../.venv/bin/livekit-wakeword setup --config okay_rufus_test.yaml && ../.venv/bin/livekit-wakeword run okay_rufus_test.yaml",
    "train:wakeword:prod": "bash models/wakeword/train-prod.sh okay_rufus.yaml",
    "train:wakeword:prod:captures": "bash models/wakeword/train-prod-with-captures.sh okay_rufus.yaml",
    "test:wakeword-offline": "npm run build && node dist/scripts/test-wakeword-offline.js",
    "capture:wakeword:segment": "npm run build && node dist/scripts/segment-wakeword-captures.js"
  },
  "dependencies": {
    "@ennuicastr/webrtcaec3.js": "^0.3.0",
    "@google/genai": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@types/axios": "^0.14.4",
    "avr-vad": "^1.0.10",
    "axios": "^1.9.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "wave-resampler": "^1.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "websocket",
    "voice",
    "esp32",
    "speech-to-text",
    "text-to-speech",
    "gemini",
    "google-cloud-tts",
    "google-ai",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
