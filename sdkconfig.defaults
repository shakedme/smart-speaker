# Required for ESP-ADF v2.x with ESP-IDF 5.4+ (FreeRTOS type/API compatibility)
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# cspot/bell uses C++ exceptions (HTTP client, crypto, streams)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024

# esp_codec_dev on IDF 5.3+ uses the new I2C master driver by default
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set

# CPU headroom for concurrent Spotify decode, mic capture, and WebSocket uplink.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# cspot_player may run on core 1 below mic_audio; heavy decode can starve IDLE1.
# Disable IDLE1 WDT check and bump timeout so decode does not false-trigger WDT.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
