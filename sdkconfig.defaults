# Required for ESP-ADF v2.x with ESP-IDF 5.4+ (FreeRTOS type/API compatibility)
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# cspot/bell uses C++ exceptions (HTTP client, crypto, streams)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=1024

# esp_codec_dev on IDF 5.3+ uses the new I2C master driver by default
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set

# The cspot_player Vorbis decode task is pinned to CPU1 (priority 2) and a
# single ov_read call can monopolize the core for several seconds while
# refilling an empty sink (e.g. right after a skip_next flushes the pipeline).
# That's expected for a heavy audio decoder, but it starves IDLE1 and trips the
# task watchdog. Disable the IDLE1 WDT check and bump the timeout so the
# decoder can run uninterrupted without breaking real liveness monitoring on
# CPU0 (where networking, control, and our own MAIN task live).
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
