PORT=8080
GOOGLE_AI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# LiveKit wakeword — threshold auto-loads from models/wakeword/output/okay_rufus/okay_rufus_eval.json
# Uncomment to override after prod training:
# WAKEWORD_THRESHOLD=0.68
WAKEWORD_MODEL_PATH=models/wakeword/output/okay_rufus/okay_rufus.onnx
WAKEWORD_WINDOW_MS=2000
WAKEWORD_DEBOUNCE_MS=2000
# Min ms between predict() starts (default 80 ≈ 4× ~20ms predict). Increase if logs show backlog.
WAKEWORD_INFERENCE_INTERVAL_MS=80
WAKEWORD_PYTHON=.venv/bin/python

# Silero VAD
VAD_THRESHOLD=0.5
VAD_SILENCE_TIMEOUT_MS=1800
# Uplink gain: warn if int16 peak dBFS (0 = full scale) stays below threshold while speech=0 — possible low mic gain.
# VAD_LOW_GAIN_WARN_PEAK_DBFS=-42
# VAD_LOW_GAIN_WARN_INTERVAL_MS=5000
# VAD_LOW_GAIN_WARN=0

# Verbose voice pipeline (VAD prob incl. sub-threshold, wake skip reasons, predict_ms). Default: on unless VOICE_DEBUG=0.
# VOICE_DEBUG=0

# Throttle intervals (ms) for debug spam while tuning
# VAD_DIAG_THROTTLE_MS=400
# WAKEWORD_GATE_DIAG_THROTTLE_MS=800

# Backend WebRTC AEC3 (requires framed mic + playback_ref uplink from firmware)
# BACKEND_AEC3_ENABLED=1
# AEC_INITIAL_DELAY_MS=100
# Captures decoded 16 kHz mono s16le uplink PCM under WAKEWORD_CAPTURE_DIR.
# WAKEWORD_CAPTURE_AUDIO=1
# WAKEWORD_CAPTURE_DIR=models/wakeword/captures/raw
# Flush PCM + metadata to disk every N ms (default 1000)
# WAKEWORD_CAPTURE_FSYNC_MS=1000
